/docs/manual/*.pdf
/docs/manual/*.aux
/docs/manual/*.fdb_latexmk
/docs/manual/*.fls
/docs/manual/*.lof
/docs/manual/*.log
/docs/manual/*.lot
/docs/manual/*.out
/docs/manual/*.toc
/docs/manual/*.synctex.gz
/docs/manual/version.tex
/local/
/wheelhouse/
*.json
*.md
!README.md
!CHANGELOG.md
!/docs/wiki/*.md
!tests/fixtures/*.json
# Paper drafts (local only)
/paper/
